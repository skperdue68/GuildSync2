# =============================================================================
# GuildSync backend server configuration
# =============================================================================
# Copy this file to .env beside guildsync-backend-server.js, replace the example
# secrets, then restart the backend. Every value below is a working default or
# an obvious placeholder, never a real credential.
#
# This file is read once at startup. A few operational settings can also be
# changed live from GuildSync Reports & Admin -> Administrator Configuration;
# those are marked "Live override" below. Everything else needs a restart.
#
# Keep this file out of source control and never ship it to clients. It holds
# the Discord client secret, the session signing key and the database password.
#
# Minimum to get running:
#   Discord sign-in  DISCORD_CLIENT_ID, DISCORD_CLIENT_SECRET,
#                    DISCORD_REDIRECT_URI, DISCORD_WEB_REDIRECT_URI
#   Sessions         GUILDSYNC_JWT_SECRET
#   Database         MARIADB_HOST, MARIADB_USER, MARIADB_PASSWORD,
#                    MARIADB_DATABASE
#   Guild identity   GUILDSYNC_APPLICATIONS_GUILD_ID (or GUILDSYNC_ESO_GUILD_ID)
#   With the bot     GUILDSYNC_BOT_SOCKET_KEY
#
# Sections
#   1. HTTP listener and public URL
#   2. Discord sign-in (OAuth)
#   3. Sessions and bot authentication
#   4. MariaDB database
#   5. ESO guild identity
#   6. Desktop client version policy
#   7. Files served to browsers and clients
#   8. Raffle bonus defaults
#   9. Deposit receipt mail
#  10. Google Sheets export
#  11. Sheet rollover and archive automation
#  12. Live overrides (Administrator Configuration)
# =============================================================================


# -----------------------------------------------------------------------------
# 1. HTTP listener and public URL
# -----------------------------------------------------------------------------

# Interface the HTTP server and Socket.IO bind to. Use 0.0.0.0 behind a reverse
# proxy; 127.0.0.1 keeps the server reachable only from this machine.
HOST=0.0.0.0

# Port for HTTP and Socket.IO. The proxy must forward WebSocket upgrades to this
# port, or live updates stop working while pages still load.
PORT=3001

# Public origin of the web app. Builds absolute links, including desktop
# installer downloads. Must match the Discord web callback in section 2.
GUILDSYNC_WEB_PUBLIC_URL=https://guildsync.perdues.me


# -----------------------------------------------------------------------------
# 2. Discord sign-in (OAuth)
# -----------------------------------------------------------------------------
# One Discord application serves both the desktop client and the web app.

# Discord application ID. Public, not a secret.
DISCORD_CLIENT_ID=123456789012345678

# Discord application client secret. Server-side only: never put it in the
# desktop client or in any browser code.
DISCORD_CLIENT_SECRET=YOUR_DISCORD_CLIENT_SECRET

# Loopback callback the desktop client opens during sign-in. This exact URL must
# be listed in the Discord application's redirect URIs.
DISCORD_REDIRECT_URI=http://127.0.0.1:53682/callback

# Browser callback for web sign-in. Must also be listed in the Discord
# application and point at this backend's public origin.
DISCORD_WEB_REDIRECT_URI=https://guildsync.perdues.me/api/auth/discord/web-callback


# -----------------------------------------------------------------------------
# 3. Sessions and bot authentication
# -----------------------------------------------------------------------------

# Long random value used to sign GuildSync session tokens. Generate a unique one
# per deployment and keep it private. Changing it signs everyone out.
GUILDSYNC_JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET

# Shared key the Discord bot presents over Socket.IO. Must equal the bot's
# GUILDSYNC_BOT_KEY exactly. Leave it blank only if you do not run the bot.
GUILDSYNC_BOT_SOCKET_KEY=MATCH_THE_BOT_GUILDSYNC_BOT_KEY

# Legacy: sessions are signed JWTs, so GUILDSYNC_TOKEN_TTL_SECONDS (commented
# out in earlier examples) is ignored and does not change session lifetime.


# -----------------------------------------------------------------------------
# 4. MariaDB database
# -----------------------------------------------------------------------------
# Required. Every GuildSync record lives here. The account needs rights to
# create and update the schema on first startup; otherwise a database
# administrator must apply migrations/ first.

# Database host. 127.0.0.1 when MariaDB runs on the same machine.
MARIADB_HOST=127.0.0.1

# Database port.
MARIADB_PORT=3306

# Database account.
MARIADB_USER=guildsync

# Database password. Use a strong, unique value.
MARIADB_PASSWORD=YOUR_DATABASE_PASSWORD

# Database name. Use a separate database per ESO guild.
MARIADB_DATABASE=guildsync

# Connection pool size. Raise it only if the database can handle it.
MARIADB_CONNECTION_LIMIT=10

# Legacy: database storage is managed by MariaDB, so DATA_DIR (from older
# examples) is unused. It is kept only so its absence is not confusing.


# -----------------------------------------------------------------------------
# 5. ESO guild identity
# -----------------------------------------------------------------------------
# Binds this database to one ESO guild. Use a separate backend, bot and database
# per guild; see docs/GuildSync-Guild-Isolation.md.

# Stable numeric ESO guild ID accepted for GuildSyncApplications.lua records.
# This is the in-game guild ID, not a Discord server ID.
GUILDSYNC_APPLICATIONS_GUILD_ID=761817

# Optional, for migrations: a stable numeric ESO guild ID that enforces one
# guild across roster, banking and applications. Set it only after updating the
# add-ons and replaying or refreshing untagged pending exports. Leave blank for
# legacy mode. If both IDs are set they must match.
GUILDSYNC_ESO_GUILD_ID=
GUILDSYNC_ESO_GUILD_NAME=Alphabet Mafia


# -----------------------------------------------------------------------------
# 6. Desktop client version policy
# -----------------------------------------------------------------------------
# Controls the update check the desktop client performs on startup.

# Release version. tools/update-version.go stamps this during a release, but the
# backend reads package.json at runtime and ignores this value (it logs a
# warning when the two differ). Keep it in step so the release check stays green.
GUILDSYNC_CLIENT_VERSION=2.0.16

# Optional minimum supported desktop version. Blank or unset disables
# enforcement; otherwise use a release version such as 1.5.0. Older clients are
# blocked and shown the download link below.
GUILDSYNC_MIN_DESKTOP_VERSION=

# Fallback download page for clients with no compatible local installer.
GUILDSYNC_DESKTOP_UPDATE_URL=https://github.com/skperdue68/GuildSync/releases/latest


# -----------------------------------------------------------------------------
# 7. Files served to browsers and clients
# -----------------------------------------------------------------------------
# Both are optional. Blank uses the packaged defaults inside this directory.

# Served web bundle directory. Defaults to public/ after `npm run build:web`.
GUILDSYNC_WEB_DIST_DIR=

# Installer download directory. Defaults to public/downloads.
GUILDSYNC_DOWNLOADS_DIR=


# -----------------------------------------------------------------------------
# 8. Raffle bonus defaults
# -----------------------------------------------------------------------------
# Seed values only. Saved database policies and per-raffle overrides take
# precedence. Tiers are "hours:bonus_percent" pairs, highest bonus first.

# Master default for bonus tiers.
GUILDSYNC_RAFFLE_BONUS_ENABLED=true

# Biweekly raffle tiers. Repeat an hours value to offer several bonus levels at
# the same cutoff.
GUILDSYNC_BIWEEKLY_BONUS_TIERS=120:20,120:10,72:5,24:0

# Monthly raffle tiers.
GUILDSYNC_MONTHLY_BONUS_TIERS=168:40,168:20,168:10,144:5,24:0


# -----------------------------------------------------------------------------
# 9. Deposit receipt mail
# -----------------------------------------------------------------------------
# Rendered by the backend when the desktop client checks banking mail out.
# Live override: both templates can be edited without a restart.
#
# Supported placeholders: {recipient}, {account_name}, {display_name},
# {event_id}, {related_transaction_id}, {ticket_type}, {ticket_type_raw},
# {transaction_type}, {amount},
# {deposit_amount}, {gold_cost}, {raw_amount}, {raw_deposit_amount},
# {ticket_gold_cost}, {raw_ticket_gold_cost}, {raw_gold_cost}, {ticket_quantity},
# {tickets}, {purchased_tickets}, {purchase_date}, {data_source},
# {raffle_datetime_eastern}, {raffle_datetime}, {event_datetime},
# {event_timestamp}, {mail_request_id}, {mail_batch_id}, {note}, {note_block},
# {bonus_block}, {bonus_percent}, {bonus_tickets}, {total_tickets},
# {bonus_deadline}, {bonus_label}, {bonus_schedule}, {bonus_note_block},
# {bonus_upsell}, {bonus_upsell_tickets}, {bonus_upsell_deadline}
#
# The bonus schedule line lists the bonus percentages still available after this
# purchase, so a member sees the whole ladder and not only the next step.
#
# {amount}, {deposit_amount}, {ticket_gold_cost} and {gold_cost} are the actual
# ESO deposit/ticket cost including any +1/+3 raffle marker; raffle summaries
# strip the marker only for display. Unknown placeholders remain literal.
# Double-quoted values support escaped \n line breaks.

# Testing aid: send every checked-out receipt to one account. Leave blank for
# normal recipients.
GUILDSYNC_DEPOSIT_MAIL_FORCE_RECIPIENT=

# Mail subject. Plain text, no placeholders are expanded here.
GUILDSYNC_DEPOSIT_MAIL_SUBJECT_TEMPLATE=Alphabet Mafia Raffle Ticket Receipt

# Send the early-purchase nudge that names the higher bonus percentage a late
# purchase missed. One nudge is sent per member per raffle; turn this off to stop the
# footer entirely without changing how bonuses are earned or mailed.
GUILDSYNC_DEPOSIT_MAIL_BONUS_NUDGE_ENABLED=true

# Mail body. Keep the quotes; they let \n act as a line break. This example matches
# the built-in default, including {bonus_note_block}, which supplies the bonus lines,
# the rest of the bonus schedule and any note with the right blank line before the
# transaction ID. A template that omits the bonus placeholders still receives the
# bonus block after the body and the nudge as a footer.
GUILDSYNC_DEPOSIT_MAIL_BODY_TEMPLATE="Hi {recipient},\n\nThank you for supporting Alphabet Mafia!\n\nWe received your guild bank deposit of {amount} gold.\nTicket Credit Earned: {ticket_quantity}\n{bonus_note_block}\nTransaction ID: {event_id}\n\n-- Alphabet Mafia"


# -----------------------------------------------------------------------------
# 10. Google Sheets export
# -----------------------------------------------------------------------------
# Optional. Ordinary spreadsheet writes stay disabled unless enabled here;
# banking database ingestion works either way. Live override:
# GUILDSYNC_GOOGLE_SHEETS_ENABLED.

# Master switch for spreadsheet writes.
GUILDSYNC_GOOGLE_SHEETS_ENABLED=false

# Stable working workbook ID (not a tab gid and not an archive ID).
GUILDSYNC_GOOGLE_SHEETS_SPREADSHEET_ID=

# Service-account key file readable by the backend...
GUILDSYNC_GOOGLE_SERVICE_ACCOUNT_FILE=./service-account.json

# ...or the complete service-account JSON as one secret value. Inline JSON takes
# precedence over the file, so clear it when switching back to a file.
GUILDSYNC_GOOGLE_SERVICE_ACCOUNT_JSON=

# Exact tab titles in the working workbook, including spelling, spacing and
# case.
GUILDSYNC_GOOGLE_SHEETS_BIWEEKLY_TAB=bi-weekly raffle
GUILDSYNC_GOOGLE_SHEETS_5050_TAB=50/50

# Sheets operation/diagnostic log. Relative paths resolve from this directory.
GUILDSYNC_GOOGLE_SHEETS_LOG_FILE=logs/google-sheets.log


# -----------------------------------------------------------------------------
# 11. Sheet rollover and archive automation
# -----------------------------------------------------------------------------
# Optional and off by default. Holds sheet writes after the sales cutoff, then
# archives, resets and replays database entries. Deploy
# scripts/google-apps-script/Archive.gs first; see docs/google-sheets-logging.md.
# Live overrides: the enabled switch and the delay.

# Hold writes and roll the sheet after each raffle period.
GUILDSYNC_GOOGLE_SHEETS_ROLLOVER_ENABLED=false

# Hours to wait after the sales cutoff before rolling over.
GUILDSYNC_GOOGLE_SHEETS_ROLLOVER_DELAY_HOURS=4

# Existing Apps Script deployment URL ending in /exec (not /dev) and the secret
# that matches its ARCHIVE_SECRET script property.
GUILDSYNC_GOOGLE_ARCHIVE_WEB_APP_URL=
GUILDSYNC_GOOGLE_ARCHIVE_SECRET=


# -----------------------------------------------------------------------------
# 12. Live overrides (Administrator Configuration)
# -----------------------------------------------------------------------------
# The settings above can also be changed live in GuildSync Reports & Admin ->
# Administrator Configuration, without editing this file:
#   GUILDSYNC_GOOGLE_SHEETS_ENABLED
#   GUILDSYNC_GOOGLE_SHEETS_ROLLOVER_ENABLED
#   GUILDSYNC_GOOGLE_SHEETS_ROLLOVER_DELAY_HOURS
#   GUILDSYNC_DEPOSIT_MAIL_SUBJECT_TEMPLATE
#   GUILDSYNC_DEPOSIT_MAIL_BODY_TEMPLATE
#   GUILDSYNC_DEPOSIT_MAIL_BONUS_NUDGE_ENABLED
#   GUILDSYNC_COMMUNITY_BUYER_RAFFLE_LINGER_HOURS
#   GUILDSYNC_COMMUNITY_TRADER_WINDOW
#   GUILDSYNC_COMMUNITY_TRADER_TOP_LIMIT
#   GUILDSYNC_COMMUNITY_TRADER_GOLD_VISIBILITY
#   GUILDSYNC_COMMUNITY_HIDDEN_HIGHLIGHTS
#
# A saved override lives in the database, applies immediately and survives
# restarts. Removing an override restores the value in this file. Editing this
# file requires a restart.
#
# Community highlights: hours a closed 50/50 raffle stays on the Guild Regulars and
# Window Shoppers buyer cards after its 8 PM Eastern draw, before the next refresh shows
# the new raffle. 0 removes the linger; fractional hours are allowed.
GUILDSYNC_COMMUNITY_BUYER_RAFFLE_LINGER_HOURS=1

# Community highlights: trader card time base. raffle follows the same 50/50 span as the
# two buyer cards; 14 days counts back from each refresh.
GUILDSYNC_COMMUNITY_TRADER_WINDOW=raffle

# Community highlights: members listed on each guild trader card (1-25).
GUILDSYNC_COMMUNITY_TRADER_TOP_LIMIT=5

# Community highlights: who sees trader gold. user = approved users and admins,
# admin = admins only, never = nobody. Viewers and the Discord bot never receive amounts.
GUILDSYNC_COMMUNITY_TRADER_GOLD_VISIBILITY=user

# Community highlights: card ids to hide, comma separated. Blank shows every card.
GUILDSYNC_COMMUNITY_HIDDEN_HIGHLIGHTS=

# Bot-owned settings (member onboarding, voice mute, raffle announcements,
# archive notifications) are NOT read from this file. Set those in
# NodeJS/GuildSync-Discord-Bot/.env instead.
#
# See docs/GuildSync-Admin-Configuration.md and docs/GuildSync-Detailed-Help.md.

# Officer-initiated membership DMs. Live overrides are available in
# Reports & Admin -> Administrator Configuration -> Discord membership DMs.
# Sending remains off until an officer starts a campaign with the bot command.
GUILDSYNC_MEMBERSHIP_DM_ENABLED=false
GUILDSYNC_MEMBERSHIP_DM_REPEAT_DAYS=30
# Random wait between membership DM attempts. Changing these seconds takes effect
# on the running campaign; a faster window shortens the next scheduled attempt.
GUILDSYNC_MEMBERSHIP_DM_MIN_SECONDS=600
GUILDSYNC_MEMBERSHIP_DM_MAX_SECONDS=900
GUILDSYNC_MEMBERSHIP_DM_MESSAGE=Hello {name}! We could not find an ESO account linked to your Discord account for {guild}. Please choose an option below, or type a reply.
GUILDSYNC_MEMBERSHIP_DM_DESTINATION_TYPE=channel
GUILDSYNC_MEMBERSHIP_DM_DESTINATION_ID=
GUILDSYNC_MEMBERSHIP_DM_COMMUNITY_ROLE_ID=
