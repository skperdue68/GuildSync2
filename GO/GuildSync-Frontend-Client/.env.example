# =============================================================================
# GuildSync desktop client configuration (optional local overrides)
# =============================================================================
# Packaged defaults normally suffice; every entry here is optional.
#
# Desktop files load in this order, later values winning:
#   1. executable-directory .env
#   2. executable-directory GuildSyncSettings.txt
#   3. working-directory .env
#   4. working-directory GuildSyncSettings.txt
# Real OS environment variables take priority over all of these files.
#
# Do not put server secrets (Discord client secret, session signing key,
# database password, bot key) in this file. It ships with the desktop app.
#
# Sections
#   1. ESO SavedVariables location
#   2. SavedVariables file names
#   3. SavedVariables table names
#   4. Backend connection
#   5. Discord sign-in
#   6. Headless server build
# =============================================================================


# -----------------------------------------------------------------------------
# 1. ESO SavedVariables location
# -----------------------------------------------------------------------------
# The folder where Elder Scrolls Online writes the add-on exports this client
# watches and uploads. Leave blank to use the normal default for your OS/user.

# Optional directory override.
#
# Windows example:
# SAVED_VARS_DIR=C:\Users\YourUserName\Documents\Elder Scrolls Online\live\SavedVariables
# macOS example:
# SAVED_VARS_DIR=/Users/YourUserName/Documents/Elder Scrolls Online/live/SavedVariables
# Linux / Steam Deck / Proton example:
# SAVED_VARS_DIR=~/.local/share/Steam/steamapps/compatdata/306130/pfx/drive_c/users/steamuser/Documents/Elder Scrolls Online/live/SavedVariables
SAVED_VARS_DIR=


# -----------------------------------------------------------------------------
# 2. SavedVariables file names
# -----------------------------------------------------------------------------
# One export per add-on. Change these only if you renamed the file the add-on
# writes; the defaults are shown in each comment.

# Banking export written by the GuildSyncBanking add-on. Defaults to
# GuildSyncBanking.lua.
SAVED_VARS_BANKING_FILE_NAME=

# Roster export written by the GuildSyncRoster add-on. Defaults to
# GuildSyncRoster.lua.
SAVED_VARS_ROSTER_FILE_NAME=

# Applications export written by the GuildSyncApplications add-on. Defaults to
# GuildSyncApplications.lua.
SAVED_VARS_APPLICATIONS_FILE_NAME=

# Trader export written by the GuildSyncTrader add-on. Defaults to
# GuildSyncTrader.lua.
SAVED_VARS_TRADER_FILE_NAME=


# -----------------------------------------------------------------------------
# 3. SavedVariables table names
# -----------------------------------------------------------------------------
# Only needed if you renamed the top-level table inside a SavedVariables file.
# Leave blank to use the default shown in each comment.

# Defaults to GuildSyncBanking.
SAVED_VARS_BANKING_TABLE_NAME=

# Defaults to GuildSyncRoster.
SAVED_VARS_ROSTER_TABLE_NAME=

# Defaults to GuildSyncApplications.
SAVED_VARS_APPLICATIONS_TABLE_NAME=

# Defaults to GuildSyncTrader.
SAVED_VARS_TRADER_TABLE_NAME=


# -----------------------------------------------------------------------------
# 4. Backend connection
# -----------------------------------------------------------------------------
# Point both at your backend for public/internet use. Use the same origin for
# both: authentication happens over HTTP and live data over Socket.IO.

# Backend authentication origin.
GUILDSYNC_AUTH_SERVER_URL=https://guildsync.perdues.me

# Backend Socket.IO origin.
GUILDSYNC_SOCKET_URL=https://guildsync.perdues.me


# -----------------------------------------------------------------------------
# 5. Discord sign-in
# -----------------------------------------------------------------------------

# Loopback listener the desktop client opens for sign-in. Keep the local
# address; the packaged default is shown and must match the backend's
# DISCORD_REDIRECT_URI.
GUILDSYNC_DISCORD_REDIRECT_URI=http://127.0.0.1:53682/callback

# Optional Discord application ID override. Packaged defaults normally suffice;
# leave blank unless you run your own Discord application.
GUILDSYNC_DISCORD_CLIENT_ID=


# -----------------------------------------------------------------------------
# 6. Headless server build
# -----------------------------------------------------------------------------
# Only the server build uses these (`wails3 task server`, built with the
# `server` tag), which serves the same services and frontend over HTTP instead
# of opening a desktop window. Desktop builds ignore both values; leaving them
# unset uses the packaged defaults shown here.

# Bind address. Use 0.0.0.0 to serve other machines; 127.0.0.1 stays local.
GUILDSYNC_SERVER_HOST=127.0.0.1

# Bind port.
GUILDSYNC_SERVER_PORT=8080
